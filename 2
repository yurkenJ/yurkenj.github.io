    { key:'subscriptions',label:'Связь и подписки',  emoji:'📱', color:'#8a9bc0',
      kw:['мтс','билайн','мегафон','теле2','tele2','yota','йота','интернет','связь','тариф','подписка','нетфликс','netflix','спотифай','spotify','кинопоиск','иви','ivi','okko','окко','youtube premium','apple music','яндекс плюс','яндекс.плюс','плюс мульти','вк музыка'] },
    { key:'home',         label:'Дом и быт',         emoji:'🛋️', color:'#a09487',
      kw:['мебель','ремонт','икеа','ikea','бытовая техника','посуда','постельное','хозтовары','фикс прайс','леруа','оби','obi','сантехника','обои','краска','шкаф','диван','кровать','пылесос','холодильник'] },
    { key:'beauty',       label:'Красота',           emoji:'💅', color:'#c08a9a',
      kw:['парикмахер','стрижка','маникюр','педикюр','салон','косметика','шампунь','крем','духи','парфюм','летуаль','рив гош','бровист','эпиляция','депиляция','спа','spa'] },
    { key:'travel',       label:'Путешествия',       emoji:'✈️', color:'#7aabcc',
      kw:['билеты','билет','самолёт','самолет','поезд','гостиница','отель','хостел','путешествие','виза','ржд','аэрофлот','победа','s7','utair','отпуск','тур','booking','букинг','airbnb','авиа'] },
    { key:'education',    label:'Образование',       emoji:'📚', color:'#c0a87a',
      kw:['курсы','курс','книга','книги','учебник','обучение','мастер-класс','репетитор','литрес','litres','skillbox','скиллбокс','нетология','udemy','английский'] },
    { key:'gifts',        label:'Подарки',           emoji:'🎁', color:'#d97562',
      kw:['подарок','цветы','букет','сувенир','подарил'] },
    { key:'pets',         label:'Питомцы',           emoji:'🐾', color:'#87a87b',
      kw:['корм','ветеринар','собака','кошка','кот','пёс','пес','зоомагазин','петшоп','наполнитель','четыре лапы','ветклиника'] },
    { key:'kids',         label:'Дети',              emoji:'🧸', color:'#e8b547',
      kw:['ребёнок','ребенок','дети','детский','детская','игрушка','памперсы','подгузники','смесь','детский сад','кружок'] },
    { key:'other',        label:'Прочее',            emoji:'📦', color:'#6b6359', kw:[] },
  ];

  const INCOME_CATEGORIES = [
    { key:'salary',   label:'Зарплата',  emoji:'💼', color:'#87a87b', kw:['зарплата','аванс','оклад','зп','выплата'] },
    { key:'freelance',label:'Фриланс',   emoji:'💻', color:'#cda269', kw:['фриланс','заказ','клиент','проект','оплатил клиент','smm','смм','работа'] },
    { key:'gift_in',  label:'Подарок',   emoji:'🎁', color:'#e8b547', kw:['подарили','перевод от','помощь','мама перевела','папа перевёл'] },
    { key:'cashback', label:'Кэшбэк',    emoji:'💳', color:'#87a87b', kw:['кэшбэк','кешбек','cashback','возврат','бонусы','баллы'] },
    { key:'sale',     label:'Продажа',   emoji:'🛍️', color:'#cda269', kw:['продал','продала','авито','юла'] },
    { key:'rent',     label:'Аренда',    emoji:'🏘️', color:'#8a9bc0', kw:['сдал','аренда квартиры','арендатор'] },
    { key:'other_in', label:'Прочее',    emoji:'📈', color:'#6b6359', kw:[] },
  ];

  const ALL_CATS = [...EXPENSE_CATEGORIES,...INCOME_CATEGORIES];
  const catByKey = k => ALL_CATS.find(c=>c.key===k) || EXPENSE_CATEGORIES[EXPENSE_CATEGORIES.length-1];

  // ── УМНЫЙ ПАРСЕР v2 ─────────────────────────────────────────
  const INCOME_TRIGGERS = ['получил','получила','пришла','пришло','пришли','заработал','заработала',
    'зарплата','аванс','кэшбэк','cashback','возврат','подарили','перевод от','продал','продала','сдал'];

  const stem = w => w.length>=6 ? w.slice(0,-2) : w.length===5 ? w.slice(0,-1) : w;

  function parseInput(text, learnedRules={}) {
    if (!text?.trim()) return null;
    const lower = text.toLowerCase().replace(/ё/g,'е');
    let type = 'expense';
    for (const kw of INCOME_TRIGGERS) { if (lower.includes(kw.replace(/ё/g,'е'))) { type='income'; break; } }

    let amount = null;
    const tMatch = lower.match(/(\d+[.,]?\d*)\s*(к|тыс|тысяч)/);
    if (tMatch) {
      amount = parseFloat(tMatch[1].replace(',','.')) * 1000;
    } else {
      const nMatch = lower.match(/(\d{1,3}(?:[\s\u00A0]\d{3})+|\d+)([.,]\d+)?/);
      if (nMatch) amount = parseFloat(nMatch[0].replace(/[\s\u00A0]/g,'').replace(',','.'));
    }
    if (!amount || isNaN(amount) || amount<=0) return null;

    const words = lower.split(/[\s.,;:!?()\-—–]+/).filter(Boolean);

    // Проверяем выученные правила пользователя
    let learnedCat = null, learnedScore = 0;
    for (const [phrase, catKey] of Object.entries(learnedRules)) {
      const ph = phrase.toLowerCase().replace(/ё/g,'е');
      if (lower.includes(ph) && ph.length > learnedScore) { learnedScore=ph.length; learnedCat=catKey; }
    }

    // Скоринг по встроенному словарю
    const categories = type==='expense' ? EXPENSE_CATEGORIES : INCOME_CATEGORIES;
    let bestCat = categories[categories.length-1], bestScore = 0;
    for (const cat of categories) {
      for (const word of cat.kw) {
        const w = word.toLowerCase().replace(/ё/g,'е');
        let matches = w.includes(' ') ? lower.includes(w) : words.some(t=>t.startsWith(stem(w)));
        if (matches && w.length > bestScore) { bestScore=w.length; bestCat=cat; }
      }
    }

    const finalCat = learnedScore>0 ? catByKey(learnedCat) : bestCat;
    const confidence = learnedScore>0 ? 'learned' : bestScore>0 ? 'matched' : 'guess';
    return { amount, type, category:finalCat.key, note:text.trim(), confidence };
  }

  // ── ФОРМАТТЕРЫ ──────────────────────────────────────────────
  function fmtMoney(num, cur='RUB') {
    const c = CURRENCIES[cur]||CURRENCIES.RUB;
    const sign = num<0?'−':'';
    const abs = Math.abs(num).toLocaleString('ru-RU',{maximumFractionDigits:0});
    return `${sign}${abs} ${c.sym}`;
  }

  function formatDate(iso) {
    const d=new Date(iso), now=new Date();
    const today=new Date(now.getFullYear(),now.getMonth(),now.getDate());
    const yest=new Date(today.getTime()-86400000);
    const dDay=new Date(d.getFullYear(),d.getMonth(),d.getDate());
    if (dDay.getTime()===today.getTime()) return 'Сегодня';
    if (dDay.getTime()===yest.getTime()) return 'Вчера';
    const months=['янв','фев','мар','апр','мая','июн','июл','авг','сен','окт','ноя','дек'];
    return `${d.getDate()} ${months[d.getMonth()]}${d.getFullYear()!==now.getFullYear()?' '+d.getFullYear():''}`;
  }

  function formatTime(iso) { return new Date(iso).toLocaleTimeString('ru-RU',{hour:'2-digit',minute:'2-digit'}); }

  function plural(n,one,two,five) {
    const m=n%10,m2=n%100;
    if (m===1&&m2!==11) return one;
    if (m>=2&&m<=4&&(m2<10||m2>=20)) return two;
    return five;
  }

  // ── ХРАНИЛИЩЕ ───────────────────────────────────────────────
  const KEY = 'kopilka_v2';
  const DEFAULT = { transactions:[], budgets:{}, learned:{}, settings:{ currency:'RUB' } };

  function loadState() {
    try {
      const raw = localStorage.getItem(KEY);
      if (raw) return JSON.parse(raw);
      const old = localStorage.getItem('kopilka_v1');
      if (old) {
        const p=JSON.parse(old);
        return {...DEFAULT,...p,learned:{},settings:{...(p.settings||{}),currency:'RUB'}};
      }
    } catch(e){}
    return null;
  }

  function useStoredState() {
    const [state,setState] = useState(()=>loadState()||DEFAULT);
    useEffect(()=>{ try{localStorage.setItem(KEY,JSON.stringify(state))}catch(e){} },[state]);
    return [state,setState];
  }

  function useToast() {
    const [toast,setToast] = useState(null);
    useEffect(()=>{
      if (!toast) return;
      const t=setTimeout(()=>setToast(null),2600);
      return ()=>clearTimeout(t);
    },[toast]);
    return [toast,setToast];
  }

  // ── ИКОНКИ ──────────────────────────────────────────────────
  const I = {
    home:    p=>html`<svg viewBox="0 0 24 24" fill="none" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" ...${p}><path d="M3 10.5L12 3l9 7.5V20a1 1 0 0 1-1 1h-5v-7h-6v7H4a1 1 0 0 1-1-1z"/></svg>`,
    chart:   p=>html`<svg viewBox="0 0 24 24" fill="none" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" ...${p}><path d="M3 3v18h18"/><path d="M7 14l3-3 3 3 5-5"/></svg>`,
    list:    p=>html`<svg viewBox="0 0 24 24" fill="none" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" ...${p}><path d="M4 6h16M4 12h16M4 18h16"/></svg>`,
    target:  p=>html`<svg viewBox="0 0 24 24" fill="none" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" ...${p}><circle cx="12" cy="12" r="9"/><circle cx="12" cy="12" r="5"/><circle cx="12" cy="12" r="1.5" fill="currentColor"/></svg>`,
    settings:p=>html`<svg viewBox="0 0 24 24" fill="none" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" ...${p}><circle cx="12" cy="12" r="3"/><path d="M19.4 15a1.65 1.65 0 0 0 .33 1.82l.06.06a2 2 0 0 1-2.83 2.83l-.06-.06a1.65 1.65 0 0 0-1.82-.33 1.65 1.65 0 0 0-1 1.51V21a2 2 0 0 1-4 0v-.09A1.65 1.65 0 0 0 9 19.4a1.65 1.65 0 0 0-1.82.33l-.06.06a2 2 0 0 1-2.83-2.83l.06-.06A1.65 1.65 0 0 0 4.68 15a1.65 1.65 0 0 0-1.51-1H3a2 2 0 0 1 0-4h.09A1.65 1.65 0 0 0 4.6 9a1.65 1.65 0 0 0-.33-1.82l-.06-.06a2 2 0 0 1 2.83-2.83l.06.06A1.65 1.65 0 0 0 9 4.68a1.65 1.65 0 0 0 1-1.51V3a2 2 0 0 1 4 0v.09a1.65 1.65 0 0 0 1 1.51 1.65 1.65 0 0 0 1.82-.33l.06-.06a2 2 0 0 1 2.83 2.83l-.06.06A1.65 1.65 0 0 0 19.4 9a1.65 1.65 0 0 0 1.51 1H21a2 2 0 0 1 0 4h-.09a1.65 1.65 0 0 0-1.51 1z"/></svg>`,
    mic:     p=>html`<svg viewBox="0 0 24 24" fill="none" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" ...${p}><rect x="9" y="3" width="6" height="12" rx="3"/><path d="M5 11a7 7 0 0 0 14 0M12 18v3"/></svg>`,
    send:    p=>html`<svg viewBox="0 0 24 24" fill="none" stroke-linecap="round" stroke-linejoin="round" ...${p}><path d="M3 12l18-9-9 18-2-8-7-1z"/></svg>`,
    trash:   p=>html`<svg viewBox="0 0 24 24" fill="none" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" ...${p}><polyline points="3 6 5 6 21 6"/><path d="M19 6l-2 14a2 2 0 0 1-2 2H9a2 2 0 0 1-2-2L5 6m3 0V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2"/></svg>`,
  };

  // ── APP ─────────────────────────────────────────────────────
  function App() {
    const [state,setState] = useStoredState();
    const [tab,setTab] = useState('home');
    const [toast,setToast] = useToast();
    const [editingTx,setEditingTx] = useState(null);
    const [showSettings,setShowSettings] = useState(false);
    const currency = state.settings?.currency||'RUB';

    const addTransaction = useCallback(tx => {
      const newTx={id:'tx_'+Date.now()+'_'+Math.random().toString(36).slice(2,7),date:new Date().toISOString(),currency,...tx};
      setState(s=>({...s,transactions:[newTx,...s.transactions]}));
      const cat=catByKey(tx.category);
      setToast(`${tx.type==='income'?'+':'−'}${fmtMoney(tx.amount,currency)} · ${cat.emoji} ${cat.label}`);
    },[setState,setToast,currency]);

    const deleteTransaction = useCallback(id=>{
      setState(s=>({...s,transactions:s.transactions.filter(t=>t.id!==id)}));
      setToast('Удалено');
    },[setState,setToast]);

    const updateTransaction = useCallback((id,patch)=>{
      setState(s=>({...s,transactions:s.transactions.map(t=>t.id===id?{...t,...patch}:t)}));
    },[setState]);

    const learnFromEdit = useCallback((note,category)=>{
      if (!note?.trim()) return;
      const words=note.toLowerCase().replace(/ё/g,'е').split(/\s+/).filter(w=>w.length>=3&&!/^\d+$/.test(w));
      if (!words.length) return;
      const key=words.slice(0,2).join(' ');
      setState(s=>({...s,learned:{...s.learned,[key]:category}}));
    },[setState]);

    const setBudget = useCallback((catKey,amount)=>{
      setState(s=>{const b={...s.budgets};if(!amount||amount<=0)delete b[catKey];else b[catKey]=amount;return{...s,budgets:b};});
    },[setState]);

    const screen = (()=>{
      switch(tab){
        case 'home':    return html`<${HomeScreen} state=${state} onAdd=${addTransaction} onDeleteTx=${deleteTransaction} onEditTx=${setEditingTx} onOpenSettings=${()=>setShowSettings(true)} currency=${currency}/>`;
        case 'charts':  return html`<${ChartsScreen} state=${state} currency=${currency}/>`;
        case 'history': return html`<${HistoryScreen} state=${state} onDeleteTx=${deleteTransaction} onEditTx=${setEditingTx} currency=${currency}/>`;
        case 'budget':  return html`<${BudgetScreen} state=${state} onSetBudget=${setBudget} currency=${currency}/>`;
        default: return null;
      }
    })();

    return html`
      <${Fragment}>
        ${screen}
        <${TabBar} active=${tab} onChange=${setTab}/>
        ${toast && html`<div class="toast">${toast}</div>`}
        ${showSettings && html`<${SettingsSheet} state=${state} setState=${setState} onClose=${()=>setShowSettings(false)} setToast=${setToast}/>`}
        ${editingTx && html`<${EditSheet}
          tx=${editingTx}
          onSave=${patch=>{
            if (patch.category && patch.category!==editingTx.category) learnFromEdit(editingTx.note,patch.category);
            updateTransaction(editingTx.id,patch);
            setEditingTx(null);
            setToast('Изменено ✓');
          }}
          onClose=${()=>setEditingTx(null)}
          currency=${currency}
        />`}
      <//>
    `;
  }

  // ── TAB BAR ─────────────────────────────────────────────────
  function TabBar({active,onChange}){
    const tabs=[{key:'home',label:'Главная',icon:'home'},{key:'charts',label:'Графики',icon:'chart'},{key:'history',label:'История',icon:'list'},{key:'budget',label:'Лимиты',icon:'target'}];
    return html`<nav class="tab-bar">${tabs.map(t=>html`<button key=${t.key} class=${'tab'+(active===t.key?' active':'')} onClick=${()=>onChange(t.key)}>${I[t.icon]({})}<span>${t.label}</span></button>`)}</nav>`;
  }

  // ── HOME ─────────────────────────────────────────────────────
  function HomeScreen({state,onAdd,onDeleteTx,onEditTx,onOpenSettings,currency}){
    const totals=useMemo(()=>{let i=0,e=0;for(const t of state.transactions){if(t.type==='income')i+=t.amount;else e+=t.amount;}return{income:i,expense:e,balance:i-e};},[state.transactions]);
    const monthStart=useMemo(()=>{const d=new Date();return new Date(d.getFullYear(),d.getMonth(),1).getTime();},[]);
    const {mi,me}=useMemo(()=>{let mi=0,me=0;for(const t of state.transactions){if(new Date(t.date).getTime()<monthStart)continue;if(t.type==='income')mi+=t.amount;else me+=t.amount;}return{mi,me};},[state.transactions,monthStart]);
    const monthSpend=useMemo(()=>{const m={};for(const t of state.transactions){if(t.type!=='expense'||new Date(t.date).getTime()<monthStart)continue;m[t.category]=(m[t.category]||0)+t.amount;}return m;},[state.transactions,monthStart]);
    const warns=useMemo(()=>Object.entries(state.budgets||{}).map(([k,lim])=>{const s=monthSpend[k]||0,p=(s/lim)*100;return{cat:catByKey(k),s,lim,p,over:p>=100};}).filter(w=>w.p>=80).sort((a,b)=>b.p-a.p),[state.budgets,monthSpend]);
    const learnedCount=Object.keys(state.learned||{}).length;
    const recent=state.transactions.slice(0,10);
    return html`
      <div class="screen">
        <div class="top-bar">
          <h1>Копилка</h1>
          <div class="top-bar-actions">
            ${learnedCount>0&&html`<div class="learn-badge">🧠 ${learnedCount}</div>`}
            <button class="icon-btn" onClick=${onOpenSettings}>${I.settings({})}</button>
