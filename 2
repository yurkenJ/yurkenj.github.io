          <div style=${{margin:'16px 0 8px',fontSize:'11px',color:'var(--text-muted)',textTransform:'uppercase',letterSpacing:'.07em'}}>🧠 Обучение</div>
          <div class="setting-row">
            <div><div class="setting-row-label">Запомненных правил</div><div class="setting-row-hint">Когда поправляешь категорию — я учусь</div></div>
            <div style=${{display:'flex',alignItems:'center',gap:'8px'}}>
              <span class="learn-badge">${learnedCount}</span>
              <button class="btn" style=${{padding:'5px 10px',fontSize:'12px'}} onClick=${()=>{setState(s=>({...s,learned:{}}));setToast('Обучение сброшено');}}>Сброс</button>
            </div>
          </div>`}

        <div style=${{margin:'16px 0 8px',fontSize:'11px',color:'var(--text-muted)',textTransform:'uppercase',letterSpacing:'.07em'}}>Данные</div>
        <button class="setting-row" onClick=${exportData} style=${{width:'100%',textAlign:'left'}}>
          <div><div class="setting-row-label">📥 Скачать резервную копию</div><div class="setting-row-hint">JSON-файл со всеми записями</div></div>
        </button>
        <input ref=${fileRef} type="file" accept="application/json" style=${{display:'none'}} onChange=${importData}/>
        <button class="setting-row" onClick=${()=>fileRef.current?.click()} style=${{width:'100%',textAlign:'left'}}>
          <div><div class="setting-row-label">📤 Восстановить из копии</div><div class="setting-row-hint">Загрузить ранее сохранённый файл</div></div>
        </button>
        <button class="setting-row" onClick=${resetAll} style=${{width:'100%',textAlign:'left',color:'var(--red)',borderColor:'var(--red-glow)'}}>
          <div><div class="setting-row-label">🗑 Удалить всё</div><div class="setting-row-hint">Нельзя отменить</div></div>
        </button>
        <div style=${{marginTop:'16px',padding:'13px',background:'var(--surface-2)',borderRadius:'12px',fontSize:'12.5px',color:'var(--text-dim)',lineHeight:1.6}}>
          <strong style=${{color:'var(--text)'}}>💡 Совет:</strong> когда приложение неправильно угадало категорию — тапни на запись, поменяй. Оно запомнит навсегда.
        </div>
        <button class="btn btn-block mt-16" onClick=${onClose}>Закрыть</button>
      </div>`;
  }

  // ── MOUNT ────────────────────────────────────────────────────
  ReactDOM.createRoot(document.getElementById('app')).render(html`<${App}/>`);
  if ('serviceWorker' in navigator) navigator.serviceWorker.register('service-worker.js').catch(()=>{});
</script>
</body>
</html>
