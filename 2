  // ── CHARTS ──────────────────────────────────────────────────
  function ChartsScreen({state,currency}){
    const [range,setRange]=useState('month');
    const ranges=[{key:'week',label:'Неделя'},{key:'month',label:'Месяц'},{key:'3month',label:'3 мес'},{key:'year',label:'Год'},{key:'all',label:'Всё'}];
    const {fromTs,toTs}=useMemo(()=>{
      const now=new Date(),to=now.getTime();
      let from;
      switch(range){
        case 'week':   from=to-7*86400000;break;
        case 'month':  from=new Date(now.getFullYear(),now.getMonth(),1).getTime();break;
        case '3month': from=new Date(now.getFullYear(),now.getMonth()-2,1).getTime();break;
        case 'year':   from=new Date(now.getFullYear(),0,1).getTime();break;
        default:       from=0;
      }
      return{fromTs:from,toTs:to};
    },[range]);
    const filtered=useMemo(()=>state.transactions.filter(t=>{const ts=new Date(t.date).getTime();return ts>=fromTs&&ts<=toTs;}),[state.transactions,fromTs,toTs]);
    const expTx=filtered.filter(t=>t.type==='expense');
    const incTx=filtered.filter(t=>t.type==='income');
    const totalExp=expTx.reduce((s,t)=>s+t.amount,0);
    const totalInc=incTx.reduce((s,t)=>s+t.amount,0);
    const byCat=useMemo(()=>{const m={};for(const t of expTx)m[t.category]=(m[t.category]||0)+t.amount;return Object.entries(m).map(([k,v])=>({cat:catByKey(k),amount:v,pct:totalExp?(v/totalExp)*100:0})).sort((a,b)=>b.amount-a.amount);},[expTx,totalExp]);
    const byDay=useMemo(()=>{
      const m={};for(const t of expTx){const d=new Date(t.date);const k=`${d.getFullYear()}-${d.getMonth()}-${d.getDate()}`;m[k]=(m[k]||0)+t.amount;}
      const days=[];const s=new Date(fromTs);s.setHours(0,0,0,0);const e=new Date(toTs);e.setHours(0,0,0,0);const c=new Date(s);
      const mons=['янв','фев','мар','апр','мая','июн','июл','авг','сен','окт','ноя','дек'];let dc=0;
      while(c<=e&&dc<370){const k=`${c.getFullYear()}-${c.getMonth()}-${c.getDate()}`;days.push({date:new Date(c),amount:m[k]||0,label:`${c.getDate()}${c.getDate()===1||days.length===0?' '+mons[c.getMonth()]:''}` });c.setDate(c.getDate()+1);dc++;}
      if(days.length>31){const wks=[];for(let i=0;i<days.length;i+=7){const g=days.slice(i,i+7);wks.push({date:g[0].date,amount:g.reduce((s,d)=>s+d.amount,0),label:`${g[0].date.getDate()} ${mons[g[0].date.getMonth()]}`});}return wks;}
      return days;
    },[expTx,fromTs,toTs]);
    const maxBar=Math.max(...byDay.map(d=>d.amount),1);
    const activeCount=byDay.filter(d=>d.amount>0).length||1;
    const avgDaily=totalExp/activeCount;
    return html`
      <div class="screen">
        <div class="top-bar"><h1>Графики</h1></div>
        <div class="range-bar">${ranges.map(r=>html`<button key=${r.key} class=${'range-pill'+(range===r.key?' active':'')} onClick=${()=>setRange(r.key)}>${r.label}</button>`)}</div>
        <div class="chart-card">
          <div class="chart-title">Расходы по категориям</div>
          <div class="chart-subtitle">Итого ${fmtMoney(totalExp,currency)} · ${expTx.length} ${plural(expTx.length,'трата','траты','трат')}</div>
          ${expTx.length===0?html`<div class="empty-state" style=${{padding:'16px 0'}}><p>Нет данных</p></div>`:html`
            <${PieChart} segs=${byCat.map(c=>({v:c.amount,color:c.cat.color,label:c.cat.label}))} total=${totalExp} currency=${currency}/>
            <div class="chart-legend">${byCat.slice(0,8).map(c=>html`
              <div key=${c.cat.key} class="legend-row">
                <span class="legend-color" style=${{background:c.cat.color}}></span>
                <span class="legend-name">${c.cat.emoji} ${c.cat.label}</span>
                <span class="legend-amount">${fmtMoney(c.amount,currency)}</span>
                <span class="legend-pct">${c.pct.toFixed(0)}%</span>
              </div>`)}</div>`}
        </div>
        <div class="chart-card">
          <div class="chart-title">Динамика трат</div>
          <div class="chart-subtitle">Доходы ${fmtMoney(totalInc,currency)} · Сред/день ${fmtMoney(Math.round(avgDaily),currency)}</div>
          <div class="bar-chart">${byDay.map((d,i)=>html`
            <div key=${i} class="bar-col">
              <div class="bar-bar" style=${{height:(d.amount/maxBar*100)+'%'}}></div>
              ${(byDay.length<=14||i%Math.ceil(byDay.length/7)===0)&&html`<div class="bar-label">${d.label}</div>`}
            </div>`)}</div>
        </div>
      </div>`;
  }

  function PieChart({segs,total,currency}){
    if(!segs?.length||!total)return html`<div class="pie-wrap"><div style=${{color:'var(--text-muted)'}}>Нет данных</div></div>`;
    const r=70,inn=50,cx=90,cy=90;let cum=0;
    const paths=segs.map((s,i)=>{
      const frac=s.v/total;if(frac<=0)return null;
      const sa=cum*2*Math.PI-Math.PI/2,ea=(cum+frac)*2*Math.PI-Math.PI/2;cum+=frac;
      const la=frac>0.5?1:0;
      const x1=cx+r*Math.cos(sa),y1=cy+r*Math.sin(sa),x2=cx+r*Math.cos(ea),y2=cy+r*Math.sin(ea);
      const x3=cx+inn*Math.cos(ea),y3=cy+inn*Math.sin(ea),x4=cx+inn*Math.cos(sa),y4=cy+inn*Math.sin(sa);
      return html`<path key=${i} d=${`M ${x1} ${y1} A ${r} ${r} 0 ${la} 1 ${x2} ${y2} L ${x3} ${y3} A ${inn} ${inn} 0 ${la} 0 ${x4} ${y4} Z`} fill=${s.color} stroke="var(--surface)" stroke-width="1.5"/>`;
    });
    return html`<div class="pie-wrap"><svg class="pie-svg" viewBox="0 0 180 180">${paths}</svg><div class="pie-center"><div class="pie-center-amount">${fmtMoney(total,currency)}</div><div class="pie-center-label">расходы</div></div></div>`;
  }

