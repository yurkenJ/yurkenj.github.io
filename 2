  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Instrument+Serif:ital@0;1&family=IBM+Plex+Sans:wght@300;400;500;600;700&family=IBM+Plex+Mono:wght@400;500;600&display=swap" rel="stylesheet">
  <style>
    :root {
      --bg:#131210;--bg-deep:#0c0b0a;--surface:#1c1a17;--surface-2:#252220;--surface-3:#2e2a26;
      --border:rgba(205,162,105,.10);--border-strong:rgba(205,162,105,.22);
      --text:#f3ece0;--text-dim:#a09487;--text-muted:#6b6359;
      --gold:#cda269;--gold-light:#ebc68e;--gold-dark:#a07840;--gold-glow:rgba(205,162,105,.18);
      --green:#87a87b;--green-bright:#a8d49a;--green-glow:rgba(135,168,123,.16);
      --red:#d97562;--red-bright:#f0907a;--red-glow:rgba(217,117,98,.16);
      --amber:#e8b547;--amber-glow:rgba(232,181,71,.18);
      --safe-top:env(safe-area-inset-top,0px);--safe-bot:env(safe-area-inset-bottom,0px);
    }
    *{box-sizing:border-box;-webkit-tap-highlight-color:transparent}
    html,body{margin:0;padding:0;background:var(--bg);color:var(--text);font-family:'IBM Plex Sans',-apple-system,system-ui,sans-serif;font-size:16px;line-height:1.5;-webkit-font-smoothing:antialiased;overscroll-behavior-y:contain}
    body{min-height:100dvh;background:radial-gradient(ellipse at 20% -10%,rgba(205,162,105,.07),transparent 50%),radial-gradient(ellipse at 100% 100%,rgba(135,168,123,.04),transparent 50%),var(--bg)}
    button,input,textarea,select{font-family:inherit;font-size:inherit;color:inherit}
    button{background:none;border:none;cursor:pointer;padding:0}
    ::-webkit-scrollbar{width:0;height:0}
    .num{font-variant-numeric:tabular-nums;font-feature-settings:"tnum"}
    #app{max-width:480px;margin:0 auto;min-height:100dvh;padding-top:var(--safe-top);padding-bottom:calc(72px + var(--safe-bot))}
    .screen{padding:8px 20px 28px;animation:fadeIn .25s ease-out}
    @keyframes fadeIn{from{opacity:0;transform:translateY(6px)}to{opacity:1;transform:translateY(0)}}
    @keyframes scaleIn{from{opacity:0;transform:scale(.94)}to{opacity:1;transform:scale(1)}}
    @keyframes slideUp{from{transform:translateY(100%)}to{transform:translateY(0)}}
    @keyframes pulse{0%,100%{box-shadow:0 0 0 0 var(--red-glow)}50%{box-shadow:0 0 0 10px transparent}}
    @keyframes toastIn{from{opacity:0;transform:translate(-50%,12px)}to{opacity:1;transform:translate(-50%,0)}}

    .top-bar{display:flex;justify-content:space-between;align-items:center;padding:16px 4px 8px}
    .top-bar h1{margin:0;font-size:32px;font-family:'Instrument Serif',Georgia,serif;font-weight:400;letter-spacing:-.01em}
    .top-bar-actions{display:flex;gap:8px;align-items:center}
    .icon-btn{width:40px;height:40px;border-radius:12px;background:var(--surface);border:1px solid var(--border);display:flex;align-items:center;justify-content:center;transition:all .15s}
    .icon-btn:active{transform:scale(.92);background:var(--surface-2)}
    .icon-btn svg{width:20px;height:20px;stroke:var(--text-dim)}

    .balance-card{border-radius:28px;padding:26px 22px 22px;margin-top:8px;position:relative;overflow:hidden;background:linear-gradient(145deg,#211e1a,#1a1714 60%,#1f1c18);border:1px solid var(--border)}
    .balance-card::before{content:"";position:absolute;top:-60px;right:-60px;width:200px;height:200px;background:radial-gradient(circle,rgba(205,162,105,.12),transparent 65%);pointer-events:none}
    .balance-card::after{content:"";position:absolute;bottom:-40px;left:-40px;width:160px;height:160px;background:radial-gradient(circle,rgba(135,168,123,.07),transparent 65%);pointer-events:none}
    .balance-label{color:var(--text-muted);font-size:11px;text-transform:uppercase;letter-spacing:.1em;margin-bottom:6px}
    .balance-currency-badge{display:inline-flex;align-items:center;gap:5px;padding:3px 10px;background:var(--gold-glow);border:1px solid rgba(205,162,105,.25);border-radius:20px;font-size:11px;color:var(--gold-light);font-weight:500;letter-spacing:.04em;margin-bottom:10px;cursor:pointer;transition:all .15s}
    .balance-currency-badge:active{transform:scale(.95)}
    .balance-amount{font-family:'Instrument Serif',Georgia,serif;font-size:48px;line-height:1;font-variant-numeric:tabular-nums;letter-spacing:-.02em;position:relative;z-index:1}
    .balance-amount .sym{font-size:28px;color:var(--gold);margin-left:5px;opacity:.9}
    .balance-amount.negative{color:var(--red-bright)}
    .balance-stats{display:grid;grid-template-columns:1fr 1fr;gap:10px;margin-top:18px;position:relative;z-index:1}
    .balance-stat{background:rgba(0,0,0,.22);border:1px solid rgba(255,255,255,.04);border-radius:16px;padding:12px 14px}
    .balance-stat-label{display:flex;align-items:center;gap:6px;font-size:11px;text-transform:uppercase;letter-spacing:.05em;color:var(--text-muted);margin-bottom:4px}
    .balance-stat-amount{font-family:'IBM Plex Mono',monospace;font-size:17px;font-weight:500;font-variant-numeric:tabular-nums}
    .income-color{color:var(--green-bright)}
    .expense-color{color:var(--red-bright)}
    .dot{display:inline-block;width:6px;height:6px;border-radius:50%;background:currentColor;flex-shrink:0}
    .month-strip{display:flex;gap:6px;margin-top:10px;position:relative;z-index:1}
    .month-pill{flex:1;background:rgba(0,0,0,.15);border:1px solid rgba(255,255,255,.04);border-radius:10px;padding:8px 8px;text-align:center}
    .month-pill-label{font-size:10px;color:var(--text-muted);text-transform:uppercase;letter-spacing:.04em}
    .month-pill-val{font-family:'IBM Plex Mono',monospace;font-size:12px;font-weight:500;margin-top:2px;font-variant-numeric:tabular-nums}

    .input-card{background:var(--surface);border:1px solid var(--border);border-radius:22px;padding:14px 16px;margin-top:14px;transition:border-color .2s,box-shadow .2s}
    .input-card:focus-within{border-color:var(--border-strong);box-shadow:0 0 0 3px rgba(205,162,105,.06)}
    .input-row{display:flex;align-items:center;gap:8px}
    .input-text{flex:1;background:transparent;border:none;outline:none;color:var(--text);font-size:16px;padding:8px 4px;min-width:0}
    .input-text::placeholder{color:var(--text-muted)}
    .mic-btn,.send-btn{width:40px;height:40px;border-radius:12px;display:flex;align-items:center;justify-content:center;flex-shrink:0;transition:all .15s}
    .mic-btn{background:var(--surface-2);border:1px solid var(--border)}
    .mic-btn svg{width:18px;height:18px;stroke:var(--text-dim)}
    .mic-btn:active{transform:scale(.92)}
    .mic-btn.listening{background:var(--red-glow);border-color:var(--red);animation:pulse 1.2s infinite}
    .mic-btn.listening svg{stroke:var(--red)}
    .send-btn{background:linear-gradient(140deg,var(--gold-light),var(--gold));border:none}
    .send-btn svg{width:18px;height:18px;stroke:#0c0b0a;stroke-width:2.5}
    .send-btn:active{transform:scale(.92)}
    .send-btn:disabled{opacity:.4}
    .input-preview{display:flex;align-items:center;gap:8px;margin-top:10px;padding-top:10px;border-top:1px solid var(--border);animation:scaleIn .18s;flex-wrap:wrap}
    .preview-amount{font-family:'IBM Plex Mono',monospace;font-weight:600;font-size:16px}
    .preview-amount.income{color:var(--green-bright)}
    .preview-amount.expense{color:var(--red-bright)}
    .preview-cat{display:inline-flex;align-items:center;gap:6px;padding:5px 10px;background:var(--surface-2);border:1px solid var(--border);border-radius:8px;font-size:13px}
    .preview-confidence{font-size:11px;color:var(--text-muted);margin-left:auto;display:flex;align-items:center;gap:4px}
    .conf-dot{width:6px;height:6px;border-radius:50%;flex-shrink:0}
    .conf-dot.high{background:var(--green)}
    .conf-dot.low{background:var(--amber)}

    .section-header{display:flex;justify-content:space-between;align-items:baseline;margin:22px 4px 10px}
    .section-title{font-family:'Instrument Serif',Georgia,serif;font-size:22px;letter-spacing:-.01em}
    .section-link{color:var(--text-muted);font-size:13px;cursor:pointer}

    .tx-list{display:flex;flex-direction:column;gap:5px}
    .tx-day-group{margin-bottom:10px}
    .tx-day-label{color:var(--text-muted);font-size:11px;text-transform:uppercase;letter-spacing:.07em;margin:8px 4px 5px;display:flex;align-items:center;gap:8px}
    .tx-day-label::after{content:"";flex:1;height:1px;background:var(--border)}
    .tx-item{display:flex;align-items:center;gap:12px;padding:11px 14px;background:var(--surface);border:1px solid var(--border);border-radius:16px;transition:background .15s;position:relative;overflow:hidden}
    .tx-item::before{content:"";position:absolute;left:0;top:0;bottom:0;width:3px;border-radius:3px 0 0 3px;background:var(--green);opacity:0;transition:opacity .2s}
    .tx-item.income::before{opacity:1}
    .tx-item:active{background:var(--surface-2)}
    .tx-icon{width:38px;height:38px;border-radius:11px;background:var(--surface-2);display:flex;align-items:center;justify-content:center;font-size:18px;flex-shrink:0}
    .tx-info{flex:1;min-width:0}
    .tx-note{font-size:14px;color:var(--text);overflow:hidden;text-overflow:ellipsis;white-space:nowrap;line-height:1.3}
    .tx-cat{font-size:11.5px;color:var(--text-muted);margin-top:1px}
    .tx-amount{font-family:'IBM Plex Mono',monospace;font-weight:500;font-size:15px;flex-shrink:0;font-variant-numeric:tabular-nums}
    .tx-amount.expense{color:var(--text)}
    .tx-amount.income{color:var(--green-bright)}
    .empty-state{text-align:center;padding:40px 20px;color:var(--text-muted)}
    .empty-state .emoji{font-size:36px;margin-bottom:12px;opacity:.6}
    .empty-state p{margin:4px 0;font-size:14px}

    .budget-warning{background:var(--surface);border:1px solid var(--amber);border-radius:16px;padding:13px 15px;margin-top:10px;display:flex;gap:12px;align-items:flex-start;animation:scaleIn .2s}
    .budget-warning.over{border-color:var(--red)}
    .budget-warning-icon{font-size:20px;flex-shrink:0}
    .budget-warning-title{font-weight:500;font-size:13.5px}
    .budget-warning-text{font-size:12.5px;color:var(--text-dim);margin-top:2px}
    .budget-row{background:var(--surface);border:1px solid var(--border);border-radius:16px;padding:13px 15px;margin-bottom:7px}
    .budget-row-top{display:flex;justify-content:space-between;align-items:center;margin-bottom:8px}
    .budget-row-cat{display:flex;align-items:center;gap:10px}
    .budget-row-cat .emoji{font-size:18px}
    .budget-row-name{font-size:14px}
    .budget-row-amount{font-family:'IBM Plex Mono',monospace;font-size:12.5px;color:var(--text-dim);font-variant-numeric:tabular-nums}
    .budget-row-amount .spent{color:var(--text)}
    .budget-bar{height:5px;background:var(--surface-2);border-radius:3px;overflow:hidden;margin-top:6px}
    .budget-bar-fill{height:100%;background:var(--gold);transition:width .4s;border-radius:3px}
    .budget-bar-fill.warn{background:var(--amber)}
    .budget-bar-fill.over{background:var(--red)}
    .budget-input{background:var(--surface-2);border:1px solid var(--border);border-radius:8px;padding:5px 9px;width:96px;text-align:right;font-family:'IBM Plex Mono',monospace;outline:none;font-size:14px}
    .budget-input:focus{border-color:var(--gold)}

    .tab-bar{position:fixed;bottom:0;left:0;right:0;max-width:480px;margin:0 auto;background:rgba(13,12,11,.9);backdrop-filter:blur(20px);-webkit-backdrop-filter:blur(20px);border-top:1px solid var(--border);padding:8px 0 calc(8px + var(--safe-bot));display:flex;z-index:100}
    .tab{flex:1;display:flex;flex-direction:column;align-items:center;gap:2px;padding:6px 0;color:var(--text-muted);transition:color .15s}
    .tab svg{width:22px;height:22px;stroke:currentColor}
    .tab span{font-size:10px;letter-spacing:.02em}
    .tab.active{color:var(--gold)}
    .tab:active{transform:scale(.94)}

    .sheet-backdrop{position:fixed;inset:0;background:rgba(0,0,0,.58);backdrop-filter:blur(6px);z-index:200;animation:fadeIn .2s}
    .sheet{position:fixed;bottom:0;left:0;right:0;max-width:480px;margin:0 auto;background:var(--surface);border-top-left-radius:26px;border-top-right-radius:26px;padding:16px 20px calc(28px + var(--safe-bot));z-index:201;max-height:85vh;overflow-y:auto;animation:slideUp .25s ease-out}
    .sheet-handle{width:36px;height:4px;background:var(--border-strong);border-radius:2px;margin:0 auto 16px}
    .sheet-title{font-family:'Instrument Serif',Georgia,serif;font-size:24px;margin:0 0 16px}
    .cat-grid{display:grid;grid-template-columns:repeat(2,1fr);gap:7px;margin-bottom:12px}
    .cat-chip{display:flex;align-items:center;gap:8px;padding:10px 12px;background:var(--surface-2);border:1px solid var(--border);border-radius:12px;font-size:13px;transition:all .15s;text-align:left}
    .cat-chip:active{transform:scale(.97)}
    .cat-chip.selected{background:var(--gold-glow);border-color:var(--gold);color:var(--gold-light)}
    .cat-chip .emoji{font-size:18px}

    .chart-card{background:var(--surface);border:1px solid var(--border);border-radius:20px;padding:18px;margin-bottom:12px}
    .chart-title{font-family:'Instrument Serif',Georgia,serif;font-size:18px;margin-bottom:3px}
    .chart-subtitle{font-size:12px;color:var(--text-muted);margin-bottom:14px}
    .chart-legend{display:flex;flex-direction:column;gap:5px;margin-top:12px}
    .legend-row{display:flex;align-items:center;gap:10px;font-size:13px}
    .legend-color{width:10px;height:10px;border-radius:3px;flex-shrink:0}
    .legend-name{flex:1;color:var(--text-dim)}
    .legend-amount{font-family:'IBM Plex Mono',monospace;font-weight:500;color:var(--text);font-variant-numeric:tabular-nums}
    .legend-pct{color:var(--text-muted);font-size:12px;min-width:34px;text-align:right}
    .range-bar{display:flex;gap:6px;margin-bottom:12px;overflow-x:auto;padding-bottom:4px}
    .range-pill{padding:7px 14px;background:var(--surface);border:1px solid var(--border);border-radius:20px;font-size:13px;white-space:nowrap;flex-shrink:0;color:var(--text-dim)}
    .range-pill.active{background:var(--gold-glow);border-color:var(--gold);color:var(--gold-light)}
    .bar-chart{display:flex;align-items:flex-end;gap:3px;height:130px;padding:6px 0}
    .bar-col{flex:1;display:flex;flex-direction:column;align-items:center;gap:5px;min-width:0}
    .bar-bar{width:100%;background:linear-gradient(180deg,var(--gold-light),rgba(205,162,105,.45));border-radius:3px 3px 0 0;min-height:2px}
    .bar-label{font-size:9.5px;color:var(--text-muted);font-variant-numeric:tabular-nums}
    .pie-wrap{display:flex;justify-content:center;align-items:center;padding:6px 0;position:relative}
    .pie-svg{width:180px;height:180px}
    .pie-center{position:absolute;text-align:center;pointer-events:none}
    .pie-center-amount{font-family:'Instrument Serif',Georgia,serif;font-size:20px}
    .pie-center-label{font-size:11px;color:var(--text-muted);text-transform:uppercase;letter-spacing:.06em}

    .search-input{background:var(--surface);border:1px solid var(--border);border-radius:14px;padding:11px 16px;width:100%;outline:none;transition:border-color .15s}
    .search-input:focus{border-color:var(--border-strong)}
    .filter-chips{display:flex;gap:6px;overflow-x:auto;padding:10px 0 6px}
    .filter-chip{padding:6px 12px;background:var(--surface);border:1px solid var(--border);border-radius:14px;font-size:12.5px;flex-shrink:0;color:var(--text-dim)}
    .filter-chip.active{background:var(--gold-glow);border-color:var(--gold);color:var(--gold-light)}

    .toast{position:fixed;bottom:calc(90px + var(--safe-bot));left:50%;transform:translateX(-50%);background:var(--surface-3);border:1px solid var(--border-strong);padding:11px 16px;border-radius:14px;font-size:13.5px;z-index:300;animation:toastIn .22s ease-out;box-shadow:0 12px 40px rgba(0,0,0,.55);display:flex;align-items:center;gap:8px;white-space:nowrap}

    .setting-row{display:flex;justify-content:space-between;align-items:center;padding:13px 15px;background:var(--surface);border:1px solid var(--border);border-radius:14px;margin-bottom:7px;gap:12px}
    .setting-row-label{font-size:14px}
    .setting-row-hint{font-size:12px;color:var(--text-muted);margin-top:2px}
    .currency-grid{display:grid;grid-template-columns:repeat(4,1fr);gap:6px;margin-top:8px}
    .currency-btn{display:flex;flex-direction:column;align-items:center;gap:4px;padding:10px 6px;background:var(--surface-2);border:1px solid var(--border);border-radius:12px;transition:all .15s;cursor:pointer}
    .currency-btn:active{transform:scale(.95)}
    .currency-btn.selected{background:var(--gold-glow);border-color:var(--gold)}
    .currency-btn .cur-sym{font-family:'IBM Plex Mono',monospace;font-size:18px;font-weight:600;color:var(--gold-light)}
    .currency-btn .cur-name{font-size:10px;color:var(--text-muted)}
    .currency-btn.selected .cur-name{color:var(--gold)}
    .learn-badge{display:inline-flex;align-items:center;gap:4px;padding:4px 9px;border-radius:8px;font-size:11px;background:var(--gold-glow);color:var(--gold-light);border:1px solid rgba(205,162,105,.2)}

    .text-input{background:var(--surface-2);border:1px solid var(--border);border-radius:10px;padding:10px 12px;width:100%;outline:none;font-size:14px}
    .text-input:focus{border-color:var(--gold)}
