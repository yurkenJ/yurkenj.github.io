  // ── QUICK ADD ────────────────────────────────────────────────
  function QuickAdd({onAdd,learned,currency}){
    const [text,setText]=useState('');
    const [listening,setListening]=useState(false);
    const rRef=useRef(null);
    const parsed=useMemo(()=>parseInput(text,learned),[text,learned]);
    const submit=()=>{if(!parsed)return;onAdd({amount:parsed.amount,type:parsed.type,category:parsed.category,note:parsed.note});setText('');};
    const startVoice=()=>{
      const SR=window.SpeechRecognition||window.webkitSpeechRecognition;
      if(!SR){alert('Голосовой ввод: нужен Safari на iPhone');return;}
      try{const r=new SR();r.lang='ru-RU';r.interimResults=true;r.continuous=false;
        r.onresult=e=>{let s='';for(let i=e.resultIndex;i<e.results.length;i++)s+=e.results[i][0].transcript;setText(s);};
        r.onend=()=>setListening(false);r.onerror=()=>setListening(false);
        rRef.current=r;r.start();setListening(true);
      }catch(e){setListening(false);}
    };
    const stopVoice=()=>{try{rRef.current?.stop();}catch(e){}setListening(false);};
    const cat=parsed?catByKey(parsed.category):null;
    const confLabel={learned:'Запомнил ✓',matched:'Угадал',guess:'По умолчанию'};
    const confClass={learned:'high',matched:'high',guess:'low'};
    return html`
      <div class="input-card">
        <div class="input-row">
          <input class="input-text" type="text" placeholder="напр. потратил 300 на кофе"
            value=${text} onChange=${e=>setText(e.target.value)} onKeyDown=${e=>e.key==='Enter'&&submit()}
            autoComplete="off" autoCorrect="off"/>
          <button class=${'mic-btn'+(listening?' listening':'')} onClick=${listening?stopVoice:startVoice}>${I.mic({})}</button>
          <button class="send-btn" onClick=${submit} disabled=${!parsed}>${I.send({})}</button>
        </div>
        ${parsed&&html`
          <div class="input-preview">
            <span class=${'preview-amount num '+parsed.type}>${parsed.type==='income'?'+':'−'}${fmtMoney(parsed.amount,currency)}</span>
            <span class="preview-cat">${cat.emoji} ${cat.label}</span>
            <span class="preview-confidence">
              <span class=${'conf-dot '+confClass[parsed.confidence]}></span>
              ${confLabel[parsed.confidence]}
            </span>
          </div>`}
      </div>`;
  }

